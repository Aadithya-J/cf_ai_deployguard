{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "deployguard-demo-target",
  "account_id": "3d29ff5d48d777df7b06222c454e3d98",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-11",
  "workers_dev": true,
  "preview_urls": true,
  "version_metadata": { "binding": "WORKER_VERSION" },
  "vars": {
    "RELEASE": "stable-v1",
    "GREETING": "Hello"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  }
}
